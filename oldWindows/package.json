{
  "name": "webguide-foroldwin",
  "version": "1.2.0",
  "description": "WebGuide for OldWindows Win7 Win8 Win8.1",
  "main": "app/main.js",
  "scripts": {
    "start": "electron .",
    "build-win": "electron-builder --win nsis zip"
  },
  "keywords": ["electron", "editor", "Win7", "Win8"],
  "author": "T-PageCode",
  "license": "GPL-3.0-or-later",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^20.4.4",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "io.github.t-pagecode.webguide.oldwin",
    "productName": "WebGuide - OldWindows",
    "copyright": "Copyright © 2026 T-PageCode",
    "publish": [
      {
        "provider": "github",
        "owner": "T-PageCode",
        "repo": "WebGuide"
      }
    ],
    "icon": "Build/icon.ico",
    "artifactName": "WebGuide-${version}-oldWin-Setup.${ext}",
    "compression": "store",
    "win": {
        "target": [
            "nsis",
            "zip"
         ],
      "icon": "Build/icon.ico"
    },
    "nsis": {
      "packElevateHelper": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "WebGuide for oldWin",
      "installerIcon": "Build/icon.ico",
      "uninstallerIcon": "Build/icon.ico"
    }
  }
}