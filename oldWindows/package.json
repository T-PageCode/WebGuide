{
  "name": "T-PageCode-OldWin",
  "version": "1.1.8",
  "description": "T-PageCode for OldWindows Win7 Win8 Win8.1",
  "main": "app/main.js",
  "scripts": {
    "start": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && electron .",
    "build-setup": "set NODE_TLS_REJECT_UNAUTHORIZED=0 && electron-builder --win nsis"
  },
  "keywords": ["electron", "editor", "Win7", "Win8"],
  "author": "T-PageCode",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "electron": "^21.4.4",
    "electron-builder": "^23.6.0"
  },
  "build": {
    "appId": "io.github.t-pagecode.webjc.oldwin",
    "productName": "T-PageCode-OldWindows",
    "copyright": "Copyright © 2026 T-PageCode",
    "publish": [
      {
        "provider": "github",
        "owner": "T-PageCode",
        "repo": "WebJiaoCheng"
      }
    ],
    "icon": "Build/icon.ico",
    "artifactName": "T-PageCode-${version}-oldWin-Setup.exe",
    "compression": "maximum",
    "win": {
      "target": "nsis",
      "icon": "Build/icon.ico"
    },
    "nsis": {
      "packElevateHelper": false,
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "T-PageCode for oldWin",
      "installerIcon": "Build/icon.ico",
      "uninstallerIcon": "Build/icon.ico"
    }
  }
}